<div class="my-section">
  <h2 class="my-section__title">{{editable section.settings.heading field="heading" scope="section"}}</h2>

  {{#if section.settings.body}}
    <p class="my-section__body">{{editable section.settings.body field="body" scope="section"}}</p>
  {{/if}}

  {{#if section.blocks.length}}
    <div class="my-section__blocks">
      {{#each section.blocks}}{{{block this}}}{{/each}}
    </div>
  {{/if}}
</div>
{{!-- schema
{
  "$schema": "estorepark/section-schema/v0",
  "name": "Yeni bölüm",
  "tag": "section",
  "class": "my-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Başlık" },
    { "type": "textarea", "id": "body", "label": "Metin" },
    { "type": "select", "id": "width", "label": "Genişlik", "default": "contained",
      "options": [
        { "value": "contained", "label": "Sınırlı" },
        { "value": "full", "label": "Tam genişlik" },
        { "value": "narrow", "label": "Dar" }
      ] }
  ],
  "blocks": [{ "type": "text" }],
  "max_blocks": 6,
  "presets": [{ "name": "Yeni bölüm" }]
}
--}}
