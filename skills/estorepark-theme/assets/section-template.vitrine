<div class="{{section.settings.class_name}} my-section" {{editor_attributes}}>
  <h2>{{editable section.settings.heading field="heading" scope="section"}}</h2>

  {{#if section.settings.body}}
    <p>{{editable section.settings.body field="body" scope="section"}}</p>
  {{/if}}

  {{#if section.blocks.length}}
    <div class="my-section__blocks">
      {{#each section.blocks}}{{{block this}}}{{/each}}
    </div>
  {{/if}}
</div>
{{!-- schema
{
  "$schema": "estorepark/section-schema/v0",
  "name": "Yeni bölüm",
  "tag": "section",
  "class": "my-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Başlık" },
    { "type": "textarea", "id": "body", "label": "Metin" },
    { "type": "checkbox", "id": "show_border", "label": "Çerçeve göster", "default": false }
  ],
  "blocks": [{ "type": "text" }],
  "max_blocks": 6,
  "presets": [{ "name": "Yeni bölüm" }]
}
--}}
